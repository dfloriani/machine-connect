# Copy to .env before running docker compose.
# Compose reads this file both to interpolate docker-compose.yml and to
# configure the postgres, rabbitmq and backend containers.

POSTGRES_DB=machineconnect
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

JWT_SECRET=dev-secret-change-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Days of raw telemetry to keep before partitions are dropped.
TELEMETRY_RETENTION_DAYS=30
